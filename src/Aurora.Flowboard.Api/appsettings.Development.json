{
  "ConnectionStrings": {
    "Database": "Host=postgres;Port=5432;Database=auroraflowboard;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Key": "YOUR_JWT_KEY_HERE",
    "Issuer": "https://localhost:5001",
    "Audience": "https://localhost:5001",
    "LifeTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 1
  },
  "Encryption": {
    "MasterKey": "YOUR_BASE64_KEY_HERE"
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
