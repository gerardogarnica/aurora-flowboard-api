{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "aurora-flowboard-api",
    "Audience": "aurora-flowboard-clients",
    "Key": "",
    "LifeTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 100
  },
  "UserTokenCleanup": {
    "IntervalInHours": 24,
    "RetentionDays": 7,
    "BatchSize": 1000
  }
}
